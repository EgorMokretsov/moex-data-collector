# Copy to .env and replace YOUR_PASSWORD locally. Do not commit .env.
DATABASE_URL=postgresql+psycopg://moex_app:YOUR_PASSWORD@localhost:5432/moex_data
DOWNLOADS_DIR=downloads
EXTRACTED_DIR=extracted
LOG_LEVEL=INFO
# Optional PEM CA bundle for the MOEX server; TLS verification stays enabled.
# MOEX_CA_BUNDLE=C:/path/to/trusted-ca-bundle.pem
